# ==========================================
# 1. FAOSTAT Data & Raw Archives (MANDATORY)
# Course Rule: Never commit data files (>100 MB rejected by GitHub)
# ==========================================
data/
*.csv
*.tsv
*.zip
*.tar.gz
*.parquet
loader/temp/
loader/downloads/

# ==========================================
# 2. Secrets & Environment Settings (MANDATORY)
# Course Rule: Real passwords stay on laptop; commit only .env.example
# ==========================================
.env
.env.local
*.pem
*.key
db_password.txt

# ==========================================
# 3. Docker & MySQL Persistence
# Keep local volume data out of Git history
# ==========================================
mysql_data/
dbdata/
*.sql.gz

# ==========================================
# 4. Python Environment & Bytecode
# Loader container, Streamlit, and benchmark script artifacts
# ==========================================
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# ==========================================
# 5. Streamlit & UI Artifacts
# ==========================================
.streamlit/secrets.toml
app/.streamlit/secrets.toml

# ==========================================
# 6. Benchmark & Performance Outputs
# Output logs, system metrics, and test traces
# ==========================================
measure/*.log
measure/*.json
*.prof
.coverage

# ==========================================
# 7. OS & Editor Cache
# macOS and VS Code system files
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp